# ---------- Stage 1: Builder ----------
FROM node:22-alpine AS builder

WORKDIR /src

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src

RUN npm run build


# ---------- Stage 2: Runtime ----------
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /src/dist ./dist

# Run as non-root user (SECURITY BEST PRACTICE)
USER node

EXPOSE 3000

CMD ["node", "dist/index.js"]
